{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fishbattery Launcher",
  "version": "0.4.15-beta.1",
  "identifier": "app.fishbattery.launcher.tauri",
  "build": {
    "beforeDevCommand": "npm run prepare:tauri-resources && npm run dev",
    "beforeBuildCommand": "npm run build && npm run prepare:tauri-resources",
    "devUrl": "http://localhost:15000",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Fishbattery Launcher",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "decorations": false,
        "transparent": true
      }
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVFRTVBNjNGRjkzRTlEMTAKUldRUW5UNzVQNmJsN3NXeFExZzRLL0crZFJlcXdkendWMHhBRGhsQ0FHbXYzc05UM3p0YktBTFYK",
      "endpoints": []
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "resources": [
      "resources/msmc-runtime",
      "resources/secrets"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "targets": "all"
  }
}

